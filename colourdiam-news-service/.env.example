# ColourDiam News Service configuration

# Port the web server listens on
PORT=3001

# Cron schedule for automatic fetching (default: every 4 hours)
CRON_SCHEDULE=0 */4 * * *

# Static token required for /api/fetch and /api/clear. Leave empty to allow
# without token (a warning will be logged).
FETCH_TOKEN=

# Optional NewsAPI.org key. When present, newsapi.org is also queried.
NEWSAPI_KEY=

# Maximum number of articles kept in storage
MAX_ARTICLES=200

# Timeout in milliseconds for every outbound HTTP request
FETCH_TIMEOUT_MS=15000

# Set to "false" to disable auto-commit & push to GitHub after each fetch.
# When enabled, news data is committed and pushed to the configured remote.
GIT_AUTOPUSH=true

# Admin uploader (optional). Credentials should come from environment variables
# (e.g. GitHub Actions secrets), never committed to the repo.
ADMIN_BASE_URL=https://www.colourdiam.com
ADMIN_USERNAME=
ADMIN_PASSWORD=
UPLOAD_ENDPOINT=/Admin/SaveNews
MAX_UPLOAD=10
